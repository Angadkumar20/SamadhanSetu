# Server Port (default: 5000)
PORT=5000

# MongoDB Connection String (Atlas style or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/samadhansetu?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# AI Classification Service URL (default: http://localhost:5001)
AI_SERVICE_URL=http://localhost:5001

# Frontend Application URL (used in email verification & password reset links)
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (Nodemailer)
# Options: EMAIL_SERVICE (e.g. 'gmail') or EMAIL_HOST + EMAIL_PORT
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="SamadhanSetu <no-reply@samadhansetu.gov.in>"

